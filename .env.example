# SIDDHIVYA environment — copy to .env (or .env.local for `next dev`) and fill in as needed.
# The demo runs with NONE of these set. Add them only as you move toward live data.

# ── Runtime mode ────────────────────────────────────────────────────────────
# Demo mode is ON unless this is exactly "false".
# LIVE (real logins, database, empty start): set to false. See docs/GO-LIVE.md.
NEXT_PUBLIC_DEMO_MODE=true

# ── Database (production data layer) ────────────────────────────────────────
# LIVE: connect Neon in Vercel → Storage; it fills both of these by itself.
# Tables are created automatically on every deploy (scripts/prepare-db.mjs).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ── Logins (LIVE) ───────────────────────────────────────────────────────────
# Signs the login cookie. 32+ random characters. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Protects the morning job (/api/cron/daily). 32+ random characters, same command.
CRON_SECRET=

# POSTGRES_* are read by the bundled Postgres service in docker-compose.yml.
POSTGRES_USER=siddhivya
POSTGRES_PASSWORD=change-me
POSTGRES_DB=siddhivya

# ── Token vault (locks each seller's channel keys before they are stored) ───
# REQUIRED in LIVE to save seller keys. Never change it after keys are saved.
# base64 of 32 random bytes. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# ── Marketplace & advertising connectors ────────────────────────────────────
# Setting these only moves a connector from "pending configuration" to
# "configured, not authorised". Token exchange & sync are not implemented in
# this build — see docs/API_INTEGRATIONS.md.
AMAZON_SP_CLIENT_ID=
AMAZON_SP_CLIENT_SECRET=
AMAZON_SP_APP_ID=

AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=

FLIPKART_APP_ID=
FLIPKART_APP_SECRET=

META_APP_ID=
META_APP_SECRET=

# ── Website lead alerts ─────────────────────────────────────────────────────
# Demo requests and sign-ups from the public website are POSTed here as JSON
# ({ text, reference, lead }). Works with Slack / Google Chat incoming webhooks,
# n8n, Make, Zapier, or a Google Apps Script web app that emails the team and
# appends to a sheet. Leave empty and the site reports alerts as
# "pending configuration" — it never claims an alert was sent.
LEAD_WEBHOOK_URL=

# ── Public website ──────────────────────────────────────────────────────────
# The live address of the website (no trailing slash). Used for SEO: sitemap,
# canonical links and social-media preview cards.
NEXT_PUBLIC_SITE_URL=https://siddhivya.vercel.app

# ---------- One-Click Launch (docs/LAUNCH.md) ----------
# Seller approval links are signed with this (any long random text, 32+ characters).
APPROVAL_SECRET=

# Telegram alerts & daily report — token from @BotFather; TELEGRAM_CHAT_ID = the agency team's chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Facebook Page + Instagram posting (Meta Graph API). Long-lived Page token with pages_manage_posts,
# pages_read_engagement, instagram_basic, instagram_content_publish.
META_PAGE_ID=
META_PAGE_TOKEN=
META_IG_USER_ID=
META_GRAPH_VERSION=v23.0

# WhatsApp offers (Cloud API) — an approved marketing template with 3 body variables: {{1}} buyer name, {{2}} product, {{3}} price.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en

# Amazon listing creation (Selling Partner API, India) — LWA refresh token from authorising the seller's account.
AMAZON_SP_REFRESH_TOKEN=
AMAZON_SELLER_ID=

# Flipkart price & stock updates — the seller's warehouse location ID from Seller Hub.
FLIPKART_LOCATION_ID=
