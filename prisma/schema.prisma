// SIDDHIVYA live database (PostgreSQL — Neon on Vercel).
// Lean by design: products, sellers and settings are stored as JSON documents so the app can grow without
// a migration for every new field. Keys for each seller's apps are stored encrypted (AES-256-GCM).
// The earlier full relational model is kept for reference in docs/reference-full-data-model.prisma.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

/// A person who can sign in: the agency team (owner, manager) or a seller (sees only their own products).
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         String // owner | manager | seller
  clientId     String? // for sellers: which seller they belong to
  active       Boolean   @default(true)
  mustChange   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
}

/// Every product, seller, seller set-up, opt-in, settlement, lead and setting — one JSON document each.
model Doc {
  kind      String
  id        String
  clientId  String?
  data      Json
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@id([kind, id])
  @@index([kind, clientId])
}

/// A seller's keys for one app (Meta, WhatsApp, Amazon, Flipkart, Telegram). Value is encrypted.
model Secret {
  id        String   @id // `${clientId}:${channel}`
  clientId  String
  channel   String
  sealed    String
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@index([clientId])
}

/// Real orders pulled from the marketplaces.
model Order {
  id        String   @id // `${channel}:${orderId}`
  clientId  String
  channel   String
  orderId   String
  ts        DateTime
  status    String
  qty       Int      @default(1)
  sale      Float    @default(0)
  sku       String?
  raw       Json?
  createdAt DateTime @default(now())

  @@index([clientId, ts])
}

model AuditLog {
  id     String   @id @default(cuid())
  ts     DateTime @default(now())
  actor  String
  action String
  target String
}

/// Small key–value store for the scheduler (last order sync time etc.).
model Meta {
  key   String @id
  value String
}
